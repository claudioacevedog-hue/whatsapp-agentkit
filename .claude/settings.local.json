{
  "permissions": {
    "allow": [
      "Bash(python3 --version)",
      "Bash(python3 -c *)",
      "Bash(pip install *)",
      "Bash(pip3 install *)",
      "Bash(mkdir -p *)",
      "Bash(uvicorn *)",
      "Bash(python tests/*)",
      "Bash(python3 tests/*)",
      "Bash(docker *)",
      "Bash(docker compose *)",
      "Bash(cp .env.example .env)",
      "Bash(ls *)",
      "Bash(git *)",
      "Read",
      "Write",
      "Edit",
      "Glob",
      "Grep"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Read|Edit|Write|Grep|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/proteger_env.py\"",
            "onFailure": "block"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.venv/bin/python\" \"$CLAUDE_PROJECT_DIR/.claude/hooks/validar_config.py\"",
            "statusMessage": "Revisando config de Seri..."
          }
        ]
      }
    ]
  }
}
